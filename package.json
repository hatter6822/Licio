{
  "name": "licio",
  "version": "0.9.13",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "tsx scripts/free-dev-ports.ts && pnpm --parallel --filter web --filter api dev",
    "setup:llm": "tsx scripts/setup-local-llm.ts",
    "bench:llm": "tsx scripts/bench-local-llm.ts",
    "build": "pnpm --filter @licio/shared build && pnpm --filter @licio/db --filter @licio/invariants build && pnpm --filter @licio/ranking --filter @licio/governance --filter @licio/lcap build && pnpm --filter web --filter api build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:security": "tsx scripts/lint-security.ts",
    "check:no-applause": "tsx scripts/check-no-applause.ts",
    "check:no-raw-egress": "tsx scripts/check-no-raw-egress.ts",
    "check:knomosis-pins": "tsx scripts/check-knomosis-pins.ts",
    "check:lcap-p2p-split": "tsx scripts/check-lcap-p2p-split.ts",
    "check:private-p2p-split": "tsx scripts/check-private-p2p-split.ts",
    "check:lcap-schema-egress": "tsx scripts/check-lcap-schema-egress.ts",
    "check:no-p2p-server-content": "tsx scripts/check-no-p2p-server-content.ts",
    "check:no-private-cid-egress": "tsx scripts/check-no-private-cid-egress.ts",
    "check:private-rendezvous-schema": "tsx scripts/check-private-rendezvous-schema.ts",
    "check:private-bundle-transparency": "tsx scripts/check-private-bundle-transparency.ts",
    "check:p2p-endpoint-rejections": "tsx scripts/check-p2p-endpoint-rejections.ts",
    "check:p2p-ranking-exclusion": "tsx scripts/check-p2p-ranking-exclusion.ts",
    "check:p2p-search-exclusion": "tsx scripts/check-p2p-search-exclusion.ts",
    "check:p2p-mls-wrapper": "tsx scripts/check-mls-wrapper.ts",
    "gen:update-manifest": "tsx scripts/build-update-manifest.ts",
    "check:update-channel": "tsx scripts/check-update-channel.ts",
    "check:sw": "tsx scripts/check-sw-security.ts",
    "lint:lockfile": "tsx scripts/check-lockfile.ts",
    "audit:advisories": "tsx scripts/audit-advisories.ts --audit-level=high",
    "typecheck": "tsc -b && tsc -p scripts",
    "typecheck:ci": "tsc -b --force && tsc -p scripts",
    "check:deps": "tsx scripts/check-dep-budget.ts",
    "check:workspace-deps": "tsx scripts/check-workspace-deps.ts",
    "check:policy": "tsx scripts/check-policy.ts",
    "check:sql-identifiers": "tsx scripts/check-sql-identifiers.ts",
    "check:prod-parity": "tsx scripts/check-prod-parity.ts",
    "check:csp-parity": "tsx scripts/check-csp-parity.ts",
    "check:dead-exports": "tsx scripts/check-dead-exports.ts",
    "survey:internal-exports": "tsx scripts/check-dead-exports.ts --internal-only",
    "survey:barrel-reexports": "tsx scripts/check-dead-exports.ts --republished",
    "check:a11y-hue-usage": "tsx scripts/check-a11y-hue-usage.ts",
    "check:governance-kyc": "tsx scripts/check-governance-kyc.ts",
    "check:neutrality": "vitest run --project api src/__tests__/ranking-neutrality.test.ts",
    "check:lcap-scheduler": "tsx scripts/check-lcap-scheduler.ts",
    "check:adversarial": "vitest run --project api src/__tests__/invariants-ensemble-adversarial.test.ts",
    "sbom": "tsx scripts/generate-sbom.ts",
    "db:generate": "pnpm --filter @licio/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @licio/db exec drizzle-kit migrate",
    "db:push": "pnpm --filter @licio/db exec drizzle-kit push",
    "clean": "rm -rf apps/*/dist apps/*/build packages/*/dist coverage test-results playwright-report .tsbuildinfo apps/*/.tsbuildinfo packages/*/.tsbuildinfo node_modules/.cache",
    "dev:stop": "tsx scripts/free-dev-ports.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "libpg-query": "^17.7.4",
    "node-html-parser": "^9.0.0",
    "parse5": "^8.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
