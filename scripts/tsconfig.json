{
  // Typecheck for the LLM tooling scripts (they run under tsx, OUTSIDE the
  // `tsc -b` workspace graph — a wrong import or argument shape here would
  // otherwise only surface at runtime on an operator's machine; a debate
  // fixture once shipped missing a required field exactly this way). noEmit +
  // standalone: the `.js`-extension relative imports into apps/api/src and
  // packages/*/src resolve to the TypeScript SOURCES (TS's built-in .js→.ts
  // mapping under moduleResolution "bundler"), so the transitive closure is
  // re-checked here with the same strict flag set — a few seconds, no build
  // order, no emit. Widening `include` to the check-* gates is a one-line
  // change. Wired into `pnpm typecheck` / `typecheck:ci` at the root.
  //
  // `dangerous-code-patterns.ts` — the SSOT the four code-scan gates share — is
  // included because it is DEPENDENCY-FREE and so needs no extra resolution
  // setup. The remaining check-* gates are NOT a one-line addition despite the
  // note above: they import `zod` and `@licio/*` (unresolvable from this
  // standalone project) and reference DOM lib types this `lib` set omits, so
  // widening `include` to `**/*.ts` currently reports ~30 resolution errors.
  // Bringing them in means giving this project the workspace paths + lib —
  // worth doing, but a real change, not a one-liner.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The gates read BROWSER shapes (`CryptoKeyPair` in the update-manifest
    // signer, DOM sink names) and import workspace packages, so this project
    // needs the same environment the workspaces have.  Without it the include
    // below could not be widened, which is the state that let a `return false`
    // in a `number | undefined` function reach the remote twice.
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true,
    "paths": {
      // `zod` is a WORKSPACE dependency, not a root one, so it has no
      // node_modules entry at the repository root for this project to find.
      "zod": ["../packages/shared/node_modules/zod"],
      "@licio/shared": ["../packages/shared/src"],
      "@licio/shared/*": ["../packages/shared/src/*"],
      "@licio/db": ["../packages/db/src"],
      "@licio/db/*": ["../packages/db/src/*"],
      "@licio/invariants": ["../packages/invariants/src"],
      "@licio/invariants/*": ["../packages/invariants/src/*"],
      "@licio/ranking": ["../packages/ranking/src"],
      "@licio/ranking/*": ["../packages/ranking/src/*"],
      "@licio/ai-governance": ["../packages/ai-governance/src"],
      "@licio/ai-governance/*": ["../packages/ai-governance/src/*"],
      "@licio/governance": ["../packages/governance/src"],
      "@licio/governance/*": ["../packages/governance/src/*"],
      "@licio/lcap": ["../packages/lcap/src"],
      "@licio/lcap/*": ["../packages/lcap/src/*"],
      "@licio/lcap-p2p": ["../packages/lcap-p2p/src"],
      "@licio/lcap-p2p/*": ["../packages/lcap-p2p/src/*"],
      "@licio/private-p2p": ["../packages/private-p2p/src"],
      "@licio/private-p2p/*": ["../packages/private-p2p/src/*"]
    }
  },
  // Every gate and its tests.  `scripts/` sat OUTSIDE every tsconfig until now,
  // which is how a parameter type that does not exist (`CspDelivery`), an
  // interface member that was used but never declared (`FileScan.spreads`), a
  // type-only import of a name the module never exported (`NodeHandle` from
  // `typescript/unstable/ast`) and a `boolean` returned from a `number |
  // undefined` function all reached the remote — in the very code that gates
  // everything else.
  //
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
