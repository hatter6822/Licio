# Server Environment Variables
#
# For local development you do NOT need this file: `pnpm dev` boots the API on
# its in-memory stores and seeds demo data (rooms, stories, threads), so the app
# renders end-to-end with zero setup. Copy this file to .env only when you want
# dev to run against a real Postgres/Redis (e.g. `docker compose up`), then run
# `pnpm db:migrate`. In PRODUCTION every value below marked (required) is
# mandatory and the server refuses to boot without it.

# PostgreSQL connection (required in production; omit for the in-memory dev boot)
DATABASE_URL=postgresql://licio:licio_dev@localhost:5432/licio_dev

# Redis connection (required in production; omit for the in-memory dev boot).
# The compose Redis requires a password (`--requirepass`), so the URL carries
# one — the empty user before the `:` is how a redis:// URL spells
# password-only auth. Override BOTH together: REDIS_PASSWORD (read by
# docker-compose.yml) and the password in this URL are the same secret, and a
# change to one without the other fails closed with NOAUTH.
REDIS_PASSWORD=licio_dev
REDIS_URL=redis://:licio_dev@localhost:6379

# Server port (optional, default: 3001)
PORT=3001

# Environment (required: development | production | test)
NODE_ENV=development

# Log level (optional, default: info)
LOG_LEVEL=info

# CORS allowed origin (required)
CORS_ORIGIN=http://localhost:5173

# Session signing secret (required, minimum 32 characters)
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# Web Push / VAPID (optional; when unset, push is disabled). Generate a key pair
# with: pnpm --filter api exec tsx scripts/generate-vapid-keys.ts
# The PRIVATE key stays on the server and is NEVER added to the client bundle.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Governance LLM (WS-U/WS-T — lawmaking summaries, in-room moderation, debate
# adjudication). All optional. Production AND development default to the
# loopback-`local` backend with TWO role lanes (the moderation/adjudication
# split) served by vLLM — provision them with `pnpm setup:llm --docker`
# (Compose `llm` profile: two vLLM instances) or `pnpm setup:llm --runtime
# ollama --docker` (single-URL alternative):
#   development ⇒ the boot PROBES each lane's runtime; real lanes are used
#                 whenever they serve their model, and a DEV-ONLY simulated
#                 loopback runtime stands in per absent lane so AI moderation
#                 and adjudication are always live (LICIO_LLM_SIM=off disables
#                 the stand-in — dev then behaves exactly like production);
#   production  ⇒ until a lane responds, its governed surfaces fail closed to
#                 their deterministic paths and recover automatically.
# GOVERNANCE_LLM_PROVIDER=local            # local | anthropic | deterministic (opt-out)
# --- per-ROLE lanes (defaults shown; per-lane key > legacy single-lane key > default)
# GOVERNANCE_LLM_MODERATION_MODEL=Qwen/Qwen3Guard-Gen-4B      # guard safety classifier
# GOVERNANCE_LLM_MODERATION_URL=http://127.0.0.1:8001/v1      # LOOPBACK-ONLY (enforced)
# GOVERNANCE_LLM_ADJUDICATION_MODEL=Qwen/Qwen3.6-27B          # generalist (debate + summaries)
# GOVERNANCE_LLM_ADJUDICATION_URL=http://127.0.0.1:8002/v1    # LOOPBACK-ONLY (enforced)
# GOVERNANCE_LLM_MODERATION_FORMAT=auto    # auto | guard | json (guard-family models auto-detect)
# GOVERNANCE_LLM_EXTRA_RUNTIME_URLS=       # comma-separated extra loopback runtimes for
#                                          # room-ratified hub models (all loopback-enforced)
# --- legacy single-lane keys (apply to BOTH lanes — the one-runtime posture, e.g. Ollama)
# GOVERNANCE_LLM_LOCAL_URL=http://127.0.0.1:11434/v1   # LOOPBACK-ONLY (enforced)
# GOVERNANCE_LLM_MODEL=                    # one model for both lanes
# ANTHROPIC_API_KEY=                       # required only for provider=anthropic (hosted; explicit opt-in)
# GOVERNANCE_LLM_MODERATION=off            # keep the deterministic moderation proposer
# GOVERNANCE_LLM_DEBATE=off                # keep the deterministic MLP debate adjudicator
# GOVERNANCE_LLM_DEBATE_BUDGET_PER_HOUR=5000  # raise the hourly debate-adjudication budget (default 60)
# GOVERNANCE_LLM_REASONING_EFFORT=low      # local reasoning-model latency lever (none|low|medium|high;
#                                          # default low; `none` disables thinking — the qwen3-family unlock;
#                                          # `off` = never send the field. The completion layer also
#                                          # auto-negotiates per runtime, logged.)

# Model-hub candidacy (WS-U): server-side huggingface.co METADATA reads for the
# member model picker + revision-pinned candidate verification (never any room
# content). On by default; `off` disables the /v1/model-hub surface AND rejects
# hub-referencing bundles at propose time (fail-closed).
# GOVERNANCE_MODEL_HUB=off
# Operator-attested served-id aliases: a bundle may name the id the LOCAL
# runtime serves a pinned repo under (e.g. an Ollama GGUF re-serve); the pair
# must be attested here or the propose fails `hub_served_id_not_attested`
# (a servedModelId equal to the repo id needs no attestation). Comma-separated.
# GOVERNANCE_MODEL_HUB_ALIASES=Qwen/Qwen3Guard-Gen-4B=hf.co/mradermacher/Qwen3Guard-Gen-4B-GGUF:Q8_0
# HF_TOKEN=                                # optional hub token (rate-limit headroom only;
#                                          # gated models are never selectable candidates)

# Optional: Enable local HTTPS (requires mkcert certs, see CONTRIBUTING.md)
# DEV_HTTPS=true

# Client Environment Variables (VITE_ prefix required)
VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:5173

# WS-S.10 client trust anchors (BUILD-time, PUBLIC keys only — the public
# halves of LICIO_UPDATE_SIGNING_PUBLIC / LICIO_UPDATE_LOG_PUBLIC). Pinning
# them into a `pnpm build` ENGAGES the §20.6 verify-before-unlock control for
# private rooms; leave unset in development (control not engaged). A
# production release MUST set both — see docs/DEVELOPMENT.md §17.2.
# VITE_PRIVATE_BUNDLE_SIGNER_KEYS=
# VITE_PRIVATE_BUNDLE_LOG_KEY=
