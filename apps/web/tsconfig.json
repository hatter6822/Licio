{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@licio/shared": ["../../packages/shared/src"],
      "@licio/shared/*": ["../../packages/shared/src/*"],
      "@licio/invariants": ["../../packages/invariants/src"],
      "@licio/invariants/*": ["../../packages/invariants/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/invariants" }]
}
