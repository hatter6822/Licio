{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@licio/shared": ["../../packages/shared/src"],
      "@licio/shared/*": ["../../packages/shared/src/*"],
      "@licio/invariants": ["../../packages/invariants/src"],
      "@licio/invariants/*": ["../../packages/invariants/src/*"],
      "@licio/ai-governance": ["../../packages/ai-governance/src"],
      "@licio/ai-governance/*": ["../../packages/ai-governance/src/*"],
      "@licio/lcap": ["../../packages/lcap/src"],
      "@licio/lcap/*": ["../../packages/lcap/src/*"],
      "@licio/lcap-p2p": ["../../packages/lcap-p2p/src"],
      "@licio/lcap-p2p/*": ["../../packages/lcap-p2p/src/*"],
      "@licio/private-p2p": ["../../packages/private-p2p/src"],
      "@licio/private-p2p/*": ["../../packages/private-p2p/src/*"],
      "api": ["../api/src/app.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/shared/tsconfig.json" },
    { "path": "../../packages/invariants/tsconfig.json" },
    { "path": "../../packages/ai-governance/tsconfig.json" },
    { "path": "../../packages/lcap/tsconfig.json" },
    { "path": "../../packages/lcap-p2p/tsconfig.json" },
    { "path": "../../packages/private-p2p/tsconfig.json" },
    { "path": "../api/tsconfig.json" }
  ]
}
