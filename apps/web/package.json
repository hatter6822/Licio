{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:tokens": "tsx scripts/build-tokens.ts",
    "build": "tsx scripts/build-tokens.ts && vite build && tsx ../../scripts/inject-sw-trusted-types.ts && tsx ../../scripts/validate-build.ts && tsx ../../scripts/check-sw-security.ts && tsx ../../scripts/generate-sri.ts && tsx ../../scripts/check-bundle-size.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:bff": "playwright test --config=playwright.bff.config.ts",
    "test:e2e:webrtc": "playwright test --config=playwright.realwebrtc.config.ts"
  },
  "dependencies": {
    "@licio/ai-governance": "workspace:*",
    "@licio/invariants": "workspace:*",
    "@licio/lcap": "workspace:*",
    "@licio/lcap-p2p": "workspace:*",
    "@licio/private-p2p": "workspace:*",
    "@licio/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "dompurify": "^3.4.13",
    "hono": "^4.13.2",
    "jsqr": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.30",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "parse5": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
