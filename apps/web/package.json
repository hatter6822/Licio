{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:tokens": "tsx scripts/build-tokens.ts",
    "build": "tsx scripts/build-tokens.ts && vite build && tsx ../../scripts/inject-sw-trusted-types.ts && tsx ../../scripts/validate-build.ts && tsx ../../scripts/check-sw-security.ts && tsx ../../scripts/generate-sri.ts && tsx ../../scripts/check-bundle-size.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:bff": "playwright test --config=playwright.bff.config.ts",
    "test:e2e:webrtc": "playwright test --config=playwright.realwebrtc.config.ts"
  },
  "dependencies": {
    "@licio/ai-governance": "workspace:*",
    "@licio/invariants": "workspace:*",
    "@licio/lcap": "workspace:*",
    "@licio/lcap-p2p": "workspace:*",
    "@licio/private-p2p": "workspace:*",
    "@licio/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "dompurify": "^3.4.11",
    "hono": "^4.12.27",
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.0.0"
  }
}
