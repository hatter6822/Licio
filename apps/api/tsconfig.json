{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "paths": {
      "@licio/shared": ["../../packages/shared/src"],
      "@licio/shared/*": ["../../packages/shared/src/*"],
      "@licio/db": ["../../packages/db/src"],
      "@licio/db/*": ["../../packages/db/src/*"],
      "@licio/invariants": ["../../packages/invariants/src"],
      "@licio/invariants/*": ["../../packages/invariants/src/*"],
      "@licio/ranking": ["../../packages/ranking/src"],
      "@licio/ranking/*": ["../../packages/ranking/src/*"],
      "@licio/ai-governance": ["../../packages/ai-governance/src"],
      "@licio/ai-governance/*": ["../../packages/ai-governance/src/*"],
      "@licio/governance": ["../../packages/governance/src"],
      "@licio/governance/*": ["../../packages/governance/src/*"],
      "@licio/lcap": ["../../packages/lcap/src"],
      "@licio/lcap/*": ["../../packages/lcap/src/*"],
      "@licio/lcap-p2p": ["../../packages/lcap-p2p/src"],
      "@licio/lcap-p2p/*": ["../../packages/lcap-p2p/src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.json"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/db" },
    { "path": "../../packages/invariants" },
    { "path": "../../packages/ranking" },
    { "path": "../../packages/ai-governance" },
    { "path": "../../packages/governance" },
    { "path": "../../packages/lcap" },
    { "path": "../../packages/lcap-p2p" }
  ]
}
